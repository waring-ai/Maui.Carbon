<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(CarbonNetVersion)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maui.Carbon\Maui.Carbon.csproj" />
    <ProjectReference Include="..\..\tools\Maui.Carbon.Generator\Maui.Carbon.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Maui.Carbon" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\samples\Maui.Carbon.Gallery\Infrastructure\WrapLayout.cs" Link="Gallery\WrapLayout.cs" />
  </ItemGroup>

</Project>
