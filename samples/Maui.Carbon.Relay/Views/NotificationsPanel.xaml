<?xml version="1.0" encoding="utf-8" ?>
<!-- Header panel: the notification feed. Unread items show a status indicator; tapping one opens its issue. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
             xmlns:vm="clr-namespace:Maui.Carbon.Relay.ViewModels;assembly=Maui.Carbon.Relay.Core"
             xmlns:p="clr-namespace:Maui.Carbon.Relay.Presentation"
             x:Class="Maui.Carbon.Relay.Views.NotificationsPanel"
             x:DataType="vm:ShellViewModel">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,16,16,8" Spacing="4">
            <cds:CdsText Text="Notifications" TypeStyle="Heading02" />
            <cds:CdsText Text="{Binding UnreadText}" Tone="Secondary" TypeStyle="BodyCompact01" />
            <HorizontalStackLayout Spacing="0" Margin="-16,4,0,0">
                <cds:CdsButton Text="Mark all as read" Kind="Ghost" Size="Sm" Command="{Binding MarkAllReadCommand}" IsEnabled="{Binding HasUnread}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <cds:CdsContainedList x:Name="List" Label="Recent" Kind="Disclosed" Size="Lg" p:ItemsBinding.Source="{Binding Notifications}">
                <p:ItemsBinding.Template>
                    <DataTemplate x:DataType="vm:NotificationRow">
                        <cds:CdsContainedListItem IsClickable="True" Clicked="OnItemClicked">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                <cds:CdsIconIndicator Kind="{Binding Kind, Converter={x:Static p:Converters.FeedbackIndicator}}" Label=""
                                                      IsVisible="{Binding IsUnread}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <cds:CdsText Text="{Binding Title}" TypeStyle="HeadingCompact01" MaxLines="2" />
                                    <cds:CdsText Text="{Binding Body}" Tone="Secondary" TypeStyle="BodyCompact01" MaxLines="2"
                                                 IsVisible="{Binding Body, Converter={x:Static p:Converters.HasText}}" />
                                    <cds:CdsText Text="{Binding WhenText}" Tone="Helper" TypeStyle="Label01" />
                                </VerticalStackLayout>
                            </Grid>
                        </cds:CdsContainedListItem>
                    </DataTemplate>
                </p:ItemsBinding.Template>
            </cds:CdsContainedList>
        </ScrollView>
    </Grid>
</ContentView>
