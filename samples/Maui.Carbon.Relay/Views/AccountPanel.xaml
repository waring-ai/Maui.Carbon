<?xml version="1.0" encoding="utf-8" ?>
<!-- Header panel: who is signed in, the theme (applied immediately) and sign out. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
             xmlns:vm="clr-namespace:Maui.Carbon.Relay.ViewModels;assembly=Maui.Carbon.Relay.Core"
             xmlns:models="clr-namespace:Maui.Carbon.Relay.Models;assembly=Maui.Carbon.Relay.Core"
             x:Class="Maui.Carbon.Relay.Views.AccountPanel"
             x:DataType="vm:ShellViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border x:Name="Avatar" WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="Ellipse">
                    <cds:CdsText Text="{Binding Me.Initials}" TypeStyle="HeadingCompact01" Tone="OnColor"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <cds:CdsText Text="{Binding Me.Name}" TypeStyle="HeadingCompact01" />
                    <cds:CdsText Text="{Binding Me.Email}" Tone="Secondary" TypeStyle="BodyCompact01" MaxLines="1" />
                </VerticalStackLayout>
            </Grid>
            <cds:CdsRadioButtonGroup Legend="Theme" Orientation="Vertical" SelectedValue="{Binding Theme}">
                <cds:CdsRadioButton Label="White" Value="{x:Static models:ThemeChoice.White}" />
                <cds:CdsRadioButton Label="Gray 10" Value="{x:Static models:ThemeChoice.G10}" />
                <cds:CdsRadioButton Label="Gray 90" Value="{x:Static models:ThemeChoice.G90}" />
                <cds:CdsRadioButton Label="Gray 100" Value="{x:Static models:ThemeChoice.G100}" />
                <cds:CdsRadioButton Label="Match my system" Value="{x:Static models:ThemeChoice.System}" />
            </cds:CdsRadioButtonGroup>
            <VerticalStackLayout Spacing="8">
                <cds:CdsLink Text="Profile and preferences" Command="{Binding NavigateCommand}" CommandParameter="settings" />
                <cds:CdsLink Text="About Relay" Command="{Binding ShowAboutCommand}" />
            </VerticalStackLayout>
            <cds:CdsButton Text="Sign out" Kind="Tertiary" Size="Md" Icon="ArrowRight" Command="{Binding SignOutCommand}" HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
