<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               xmlns:data="clr-namespace:Maui.Carbon.Gallery.Pages.Forms.Data"
               x:Class="Maui.Carbon.Gallery.Pages.FluidForms.SelectPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Default" Description="The label sits inside the 64px field at the top start with the value below it; there is no helper text. Fluid fields live inside a FluidForm.">
            <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
        </g:GalleryExample>

        <g:GalleryExample Title="States" Description="Invalid outlines the whole field, message included, with the error under a 1px divider; a warning keeps the strong rule under its message; read-only keeps the field fill with a subtle rule; disabled is skipped by Tab.">
            <VerticalStackLayout Spacing="24" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de" IsInvalid="True" InvalidText="Frankfurt is not available on this plan."><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="us-south" IsWarning="True" WarnText="Dallas is at capacity."><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de" IsReadOnly="True"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de" IsEnabled="False"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Interactive" Description="Change the value and watch the status line.">
            <VerticalStackLayout Spacing="16" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelect x:Name="Input" Label="Region" SelectedItem="eu-de" SelectedItemChanged="OnChanged"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                <cds:CdsText x:Name="Status" Tone="Secondary" Text="Waiting for input" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Skeleton" Description="The loading placeholder: a skeleton field the size of the one it turns into, with a label bar and a value bar.">
            <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidSelectSkeleton /></cds:CdsFluidForm>
        </g:GalleryExample>

        <g:GalleryExample Title="Themes" Description="The fluid field in all four themes.">
            <g:ThemeStrip>
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsFluidForm WidthRequest="320" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

        <g:GalleryExample Title="On a layer" Description="Fluid fields on a layer-01 surface step to field-02 inside a CdsLayer.">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsFluidForm WidthRequest="320" HorizontalOptions="Start"><cds:CdsFluidSelect Label="Region" SelectedItem="eu-de"><cds:CdsSelectItem Value="us-south" Text="Dallas (us-south)" /><cds:CdsSelectItem Value="eu-de" Text="Frankfurt (eu-de)" /><cds:CdsSelectItem Value="eu-gb" Text="London (eu-gb)" /></cds:CdsFluidSelect></cds:CdsFluidForm>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
