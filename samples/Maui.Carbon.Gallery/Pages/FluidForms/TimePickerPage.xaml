<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               xmlns:data="clr-namespace:Maui.Carbon.Gallery.Pages.Forms.Data"
               x:Class="Maui.Carbon.Gallery.Pages.FluidForms.TimePickerPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Default" Description="The label sits inside the 64px field at the top start with the value below it; there is no helper text. Fluid fields live inside a FluidForm.">
            <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Start time" Text="2:30" Period="Pm" SelectedTimeZone="CET"><cds:CdsFluidTimePicker.TimeZones><x:String>CET</x:String><x:String>UTC</x:String></cds:CdsFluidTimePicker.TimeZones></cds:CdsFluidTimePicker></cds:CdsFluidForm>
        </g:GalleryExample>

        <g:GalleryExample Title="States" Description="Invalid outlines the whole field, message included, with the error under a 1px divider; a warning keeps the strong rule under its message; read-only keeps the field fill with a subtle rule; disabled is skipped by Tab.">
            <VerticalStackLayout Spacing="24" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Start time" Text="2:3" IsInvalid="True" InvalidText="Use the format hh:mm." /></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Start time" Text="2:30" IsWarning="True" WarnText="Backups also run at 3:00." /></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Backup time" Is24Hour="True" Text="14:30" /></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Start time" Text="2:30" IsReadOnly="True" /></cds:CdsFluidForm>
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker Label="Start time" Text="2:30" IsEnabled="False" /></cds:CdsFluidForm>
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Interactive" Description="Change the value and watch the status line.">
            <VerticalStackLayout Spacing="16" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><cds:CdsFluidTimePicker x:Name="Input" Label="Start time" Text="2:30" TextChanged="OnChanged" /></cds:CdsFluidForm>
                <cds:CdsText x:Name="Status" Tone="Secondary" Text="Waiting for input" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Skeleton" Description="The loading placeholder: a skeleton field the size of the one it turns into, with a label bar and a value bar.">
            <cds:CdsFluidForm WidthRequest="400" HorizontalOptions="Start"><VerticalStackLayout Spacing="24"><cds:CdsFluidTimePickerSkeleton /><cds:CdsFluidTimePickerSkeleton IsOnlyTwo="True" /></VerticalStackLayout></cds:CdsFluidForm>
        </g:GalleryExample>

        <g:GalleryExample Title="Themes" Description="The fluid field in all four themes.">
            <g:ThemeStrip>
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsFluidForm><cds:CdsFluidTimePicker Label="Start time" Text="2:30" Period="Pm" /></cds:CdsFluidForm>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

        <g:GalleryExample Title="On a layer" Description="Fluid fields on a layer-01 surface step to field-02 inside a CdsLayer.">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsFluidForm><cds:CdsFluidTimePicker Label="Start time" Text="2:30" Period="Pm" /></cds:CdsFluidForm>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
