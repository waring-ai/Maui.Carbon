<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Forms.PasswordInputPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Default" Description="Masked by default; the eye button shows or hides the characters and its tooltip appears below, end-aligned.">
            <cds:CdsPasswordInput Label="Password" Text="correct-horse" HelperText="At least 12 characters, with a number and a symbol" WidthRequest="400" HorizontalOptions="Start" />
        </g:GalleryExample>

        <g:GalleryExample Title="Revealed" Description="IsPasswordVisible starts the field revealed; the icon becomes view-off.">
            <cds:CdsPasswordInput Label="API key" Text="sk-prod-7d2f9a1e" IsPasswordVisible="True" WidthRequest="400" HorizontalOptions="Start" />
        </g:GalleryExample>

        <g:GalleryExample Title="Sizes" Description="sm 32, md 40 (default), lg 48. The toggle is as wide as the field is tall.">
            <VerticalStackLayout Spacing="24" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsPasswordInput Label="Small" Size="Sm" Text="secret" />
                <cds:CdsPasswordInput Label="Medium" Text="secret" />
                <cds:CdsPasswordInput Label="Large" Size="Lg" Text="secret" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="States" Description="Invalid and warning keep the toggle beside the status icon; disabled also disables the toggle.">
            <VerticalStackLayout Spacing="24" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsPasswordInput Label="New password" Text="short" IsInvalid="True" InvalidText="Use at least 12 characters." />
                <cds:CdsPasswordInput Label="New password" Text="password1234" IsWarning="True" WarnText="This password is easy to guess." />
                <cds:CdsPasswordInput Label="Current password" Text="correct-horse" IsReadOnly="True" />
                <cds:CdsPasswordInput Label="Recovery key" Text="correct-horse" IsEnabled="False" HelperText="Locked while the account is suspended." />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Skeleton" Description="A password input loads with the text input skeleton.">
            <VerticalStackLayout Spacing="24" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsTextInputSkeleton />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Interactive" Description="Toggle the button: the event reports each change.">
            <VerticalStackLayout Spacing="16" WidthRequest="400" HorizontalOptions="Start">
                <cds:CdsPasswordInput Label="Database password" PasswordVisibilityToggled="OnToggled" Text="hunter2-hunter2" />
                <cds:CdsText x:Name="Status" Tone="Secondary" Text="Password is hidden" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="In the four themes">
            <g:ThemeStrip>
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsPasswordInput Label="Password" Text="correct-horse" HelperText="At least 12 characters" />
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

        <g:GalleryExample Title="On a layer">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <cds:CdsPasswordInput Label="Password" Text="correct-horse" IsPasswordVisible="True" />
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
