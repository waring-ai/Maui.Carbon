<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Patterns.PatternConfirmationPage">
    <Grid>
        <VerticalStackLayout Spacing="48">

            <g:GalleryExample Title="Low impact: act at once, then offer Undo" Description="Removing a label is easy to reverse, so there is no dialog. The action happens and an actionable notification offers Undo; it has an action, so it stays until used or closed. Remove another label to try it.">
                <VerticalStackLayout Spacing="16" WidthRequest="560" HorizontalOptions="Start">
                    <cds:CdsText Text="Labels on prod-eu-01" TypeStyle="HeadingCompact02" />
                    <cds:CdsText Text="Labels help you group clusters in billing reports." TypeStyle="BodyCompact01" Tone="Secondary" />
                    <FlexLayout x:Name="LabelsRow" Wrap="Wrap" />
                    <cds:CdsActionableNotification x:Name="UndoNotice" Kind="Info" Role="Status" HasFocus="False" IsLowContrast="False"
                                                   Title="Label removed" ActionButtonLabel="Undo"
                                                   ActionClicked="OnUndoClicked" CloseRequested="OnUndoClosed" />
                </VerticalStackLayout>
            </g:GalleryExample>

            <g:GalleryExample Title="Moderate impact or several items: danger modal" Description="The title and the primary button name the action and the object. The body lists what is deleted and what is lost. Cancel left, the danger action right; focus starts on Cancel.">
                <FlexLayout Wrap="Wrap" AlignItems="Start">
                    <ContentView BackgroundColor="{DynamicResource CdsBorderSubtle01}" Padding="1" WidthRequest="420" Margin="0,0,24,24">
                        <VerticalStackLayout BackgroundColor="{DynamicResource CdsLayer01}">
                            <cds:CdsModalHeader Title="Delete 2 snapshots?" />
                            <cds:CdsModalBody HasForm="True">
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="These snapshots will be deleted from prod-eu-01:" TypeStyle="Body01" />
                                    <cds:CdsText Text="snap-2026-11-02-0200" TypeStyle="Code02" />
                                    <cds:CdsText Text="snap-2026-11-09-0200" TypeStyle="Code02" />
                                    <cds:CdsText Text="You can't restore the cluster to these points after they are deleted." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsModalBody>
                            <cds:CdsModalFooter IsDanger="True" PrimaryButtonText="Delete snapshots" SecondaryButtonText="Cancel" />
                        </VerticalStackLayout>
                    </ContentView>
                    <VerticalStackLayout Spacing="16" Margin="0,0,0,24">
                        <cds:CdsButton Text="Delete 2 snapshots" Kind="DangerTertiary" Size="Md" Clicked="OnSnapshotsClicked" />
                    </VerticalStackLayout>
                </FlexLayout>
            </g:GalleryExample>

            <g:GalleryExample Title="High impact and irreversible: type the name" Description="The person types the resource name before the danger button turns on. The label quotes the exact name and the helper text explains the disabled button. Type the rest of the name to try it.">
                <FlexLayout Wrap="Wrap" AlignItems="Start">
                    <ContentView BackgroundColor="{DynamicResource CdsBorderSubtle01}" Padding="1" WidthRequest="420" Margin="0,0,24,24">
                        <VerticalStackLayout BackgroundColor="{DynamicResource CdsLayer01}">
                            <cds:CdsModalHeader Label="prod-eu-01" Title="Delete cluster" />
                            <cds:CdsModalBody HasForm="True">
                                <VerticalStackLayout Spacing="16">
                                    <cds:CdsText Text="Deleting prod-eu-01 removes its 12 worker nodes, 184 pods and all persistent volumes. Backups in other regions are kept. You can't undo this." TypeStyle="Body01" />
                                    <cds:CdsTextInput x:Name="InlineConfirmInput" Label="Type prod-eu-01 to confirm" Text="prod-eu-0" TextChanged="OnInlineConfirmChanged"
                                                      HelperText="The Delete cluster button turns on when the name matches." />
                                </VerticalStackLayout>
                            </cds:CdsModalBody>
                            <cds:CdsModalFooter x:Name="InlineConfirmFooter" IsDanger="True" PrimaryButtonText="Delete cluster" SecondaryButtonText="Cancel" PrimaryButtonDisabled="True" />
                        </VerticalStackLayout>
                    </ContentView>
                    <VerticalStackLayout Spacing="16" Margin="0,0,0,24">
                        <cds:CdsButton Text="Delete cluster" Kind="Danger" Size="Md" Clicked="OnClusterClicked" />
                    </VerticalStackLayout>
                </FlexLayout>
            </g:GalleryExample>

            <g:GalleryExample Title="Leaving with unsaved changes: transactional modal" Description="Not a danger modal. The safe choice, Keep editing, is the primary action; Discard is the secondary.">
                <FlexLayout Wrap="Wrap" AlignItems="Start">
                    <ContentView BackgroundColor="{DynamicResource CdsBorderSubtle01}" Padding="1" WidthRequest="320" Margin="0,0,24,24">
                        <VerticalStackLayout BackgroundColor="{DynamicResource CdsLayer01}">
                            <cds:CdsModalHeader Title="Discard unsaved changes?" />
                            <cds:CdsModalBody HasForm="True">
                                <cds:CdsText Text="You changed 3 settings on Create cluster. If you leave now, those changes are lost." TypeStyle="Body01" />
                            </cds:CdsModalBody>
                            <cds:CdsModalFooter PrimaryButtonText="Keep editing" SecondaryButtonText="Discard" />
                        </VerticalStackLayout>
                    </ContentView>
                    <VerticalStackLayout Spacing="16" Margin="0,0,0,24">
                        <cds:CdsButton Text="Leave this page" Kind="Tertiary" Size="Md" Clicked="OnDiscardClicked" />
                    </VerticalStackLayout>
                </FlexLayout>
            </g:GalleryExample>

            <cds:CdsText x:Name="Status" Tone="Secondary" Text="No action yet" />
        </VerticalStackLayout>

        <cds:CdsModal x:Name="SnapshotsModal" IsDanger="True" Size="Sm" Heading="Delete 2 snapshots?" PrimaryButtonText="Delete snapshots" SecondaryButtonText="Cancel"
                      HasForm="True" RequestSubmit="OnSnapshotsDelete" RequestClose="OnSnapshotsClose">
            <VerticalStackLayout Spacing="8">
                <cds:CdsText Text="These snapshots will be deleted from prod-eu-01:" TypeStyle="Body01" />
                <cds:CdsText Text="snap-2026-11-02-0200" TypeStyle="Code02" />
                <cds:CdsText Text="snap-2026-11-09-0200" TypeStyle="Code02" />
                <cds:CdsText Text="You can't restore the cluster to these points after they are deleted." TypeStyle="Body01" />
            </VerticalStackLayout>
        </cds:CdsModal>

        <cds:CdsModal x:Name="ClusterModal" IsDanger="True" Size="Sm" Label="prod-eu-01" Heading="Delete cluster" PrimaryButtonText="Delete cluster" SecondaryButtonText="Cancel"
                      PrimaryButtonDisabled="True" HasForm="True" RequestSubmit="OnClusterDelete" RequestClose="OnClusterClose">
            <VerticalStackLayout Spacing="16">
                <cds:CdsText Text="Deleting prod-eu-01 removes its 12 worker nodes, 184 pods and all persistent volumes. Backups in other regions are kept. You can't undo this." TypeStyle="Body01" />
                <cds:CdsTextInput x:Name="ClusterConfirmInput" Label="Type prod-eu-01 to confirm" TextChanged="OnClusterConfirmChanged"
                                  HelperText="The Delete cluster button turns on when the name matches." />
            </VerticalStackLayout>
        </cds:CdsModal>

        <cds:CdsModal x:Name="DiscardModal" Size="Xs" Heading="Discard unsaved changes?" PrimaryButtonText="Keep editing" SecondaryButtonText="Discard"
                      HasForm="True" RequestSubmit="OnKeepEditing" SecondarySubmit="OnDiscard">
            <cds:CdsText Text="You changed 3 settings on Create cluster. If you leave now, those changes are lost." TypeStyle="Body01" />
        </cds:CdsModal>
    </Grid>
</g:GalleryPage>
