<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Patterns.PatternOverflowContentPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Truncation types" Description="The ellipsis replaces at least 3 characters. The full text stays reachable through a tooltip, a copy button or a details view. Hover or focus the first two to read the full value.">
            <FlexLayout Wrap="Wrap" AlignItems="Start">
                <VerticalStackLayout WidthRequest="320" Margin="0,0,24,24" Padding="16" Spacing="8" BackgroundColor="{DynamicResource CdsLayer01}">
                    <cds:CdsText Text="End: names and descriptions" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsTooltip x:Name="EndTip" Placement="Bottom" HorizontalOptions="Start">
                        <cds:CdsText x:Name="EndText" TypeStyle="Body01" LineBreakMode="TailTruncation" MaxLines="1" WidthRequest="288" />
                    </cds:CdsTooltip>
                    <cds:CdsText x:Name="EndFull" TypeStyle="Label01" Tone="Helper" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="320" Margin="0,0,24,24" Padding="16" Spacing="8" BackgroundColor="{DynamicResource CdsLayer01}">
                    <cds:CdsText Text="Front: paths where the end matters" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsTooltip x:Name="FrontTip" Placement="Bottom" HorizontalOptions="Start">
                        <cds:CdsText x:Name="FrontText" TypeStyle="Body01" LineBreakMode="HeadTruncation" MaxLines="1" WidthRequest="288" />
                    </cds:CdsTooltip>
                    <cds:CdsText x:Name="FrontFull" TypeStyle="Label01" Tone="Helper" />
                </VerticalStackLayout>
                <VerticalStackLayout WidthRequest="320" Margin="0,0,24,24" Padding="16" Spacing="8" BackgroundColor="{DynamicResource CdsLayer01}">
                    <cds:CdsText Text="Mid-line: IDs that differ at both ends" TypeStyle="Label01" Tone="Secondary" />
                    <HorizontalStackLayout Spacing="4">
                        <cds:CdsText x:Name="MidText" TypeStyle="Code02" LineBreakMode="NoWrap" MaxLines="1" VerticalOptions="Center" />
                        <cds:CdsCopyButton x:Name="MidCopy" Size="Sm" IconDescription="Copy cluster CRN" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <cds:CdsText Text="Copy always copies the full value." TypeStyle="Label01" Tone="Helper" />
                </VerticalStackLayout>
            </FlexLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="In a table" Description="Fixed column widths and end truncation in cells; names are links with a tooltip so the full value shows on hover and keyboard focus. Numbers and status are never truncated. The row menu holds the extra actions, destructive last.">
            <cds:CdsDataTable x:Name="DeploymentTable" Size="Md" OverflowMenuOnHover="False" RowActionsHeader="Actions" />
        </g:GalleryExample>

        <g:GalleryExample Title="Overflow menu and the +n tag" Description="The one or two main actions stay visible as buttons and the rest move into a flipped overflow menu at the end of the row, destructive items last after a divider. For labels, show the first few, then a +n tag that opens the rest.">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16" BackgroundColor="{DynamicResource CdsLayer01}" HeightRequest="304">
                <VerticalStackLayout Spacing="4" VerticalOptions="Start">
                    <cds:CdsText Text="prod-eu-01" TypeStyle="Heading03" />
                    <cds:CdsText Text="Kubernetes 1.31.2 in Frankfurt" TypeStyle="BodyCompact01" Tone="Secondary" />
                    <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,12,0,0">
                        <cds:CdsTag Text="env:production" Margin="0,0,8,8" />
                        <cds:CdsTag Text="team:payments" Margin="0,0,8,8" />
                        <cds:CdsTag Text="region:eu" Margin="0,0,8,8" />
                        <cds:CdsPopover x:Name="MoreLabels" Placement="BottomStart" Margin="0,0,8,8">
                            <cds:CdsOperationalTag x:Name="MoreTag" Text="+4" Clicked="OnMoreTagClicked" />
                            <cds:CdsPopover.PopoverContent>
                                <VerticalStackLayout Spacing="8" Padding="16" WidthRequest="256">
                                    <cds:CdsText Text="4 more labels" TypeStyle="HeadingCompact01" />
                                    <FlexLayout Wrap="Wrap">
                                        <cds:CdsTag Text="tier:gold" Margin="0,0,8,8" />
                                        <cds:CdsTag Text="backup:daily" Margin="0,0,8,8" />
                                        <cds:CdsTag Text="owner:platform" Margin="0,0,8,8" />
                                        <cds:CdsTag Text="compliance:pci" Margin="0,0,8,8" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </cds:CdsPopover.PopoverContent>
                        </cds:CdsPopover>
                    </FlexLayout>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Start">
                    <cds:CdsButton Text="Restart" Kind="Ghost" Icon="Restart" Size="Md" />
                    <cds:CdsButton Text="Add nodes" Icon="Add" Size="Md" />
                    <cds:CdsOverflowMenu x:Name="HeaderMenu" IconDescription="More actions for prod-eu-01" Size="Md" IsFlipped="True" IsOpen="True">
                        <cds:CdsMenuItem Text="Download config" />
                        <cds:CdsMenuItem Text="Update version" />
                        <cds:CdsMenuItem Text="Rename" />
                        <cds:CdsMenuItemDivider />
                        <cds:CdsMenuItem Text="Delete cluster" Kind="Danger" />
                    </cds:CdsOverflowMenu>
                </HorizontalStackLayout>
            </Grid>
        </g:GalleryExample>

        <FlexLayout Wrap="Wrap" AlignItems="Start">
            <g:GalleryExample Title="Show more" Description="Long text clamps to 3 lines, then a ghost button; Show less collapses it again. No fades or inner scrolling." WidthRequest="520" Margin="0,0,48,48">
                <VerticalStackLayout Spacing="8" Padding="16" BackgroundColor="{DynamicResource CdsLayer01}">
                    <cds:CdsText Text="About this cluster" TypeStyle="HeadingCompact01" />
                    <cds:CdsText x:Name="AboutText" TypeStyle="Body01" LineBreakMode="TailTruncation" MaxLines="3"
                                 Text="prod-eu-01 runs the EU storefront: checkout, catalog, search and the payment webhooks. It has 3 worker pools across eu-de-1, eu-de-2 and eu-de-3 so a zone outage leaves two thirds of capacity. Autoscaling adds up to 8 nodes per pool when CPU stays above 70% for 5 minutes. Maintenance runs on the first Sunday of each month between 02:00 and 04:00 CET; workloads are drained one node at a time. Contact the platform team in #platform-eu before changing node pools or ingress rules." />
                    <cds:CdsButton x:Name="ShowMoreButton" Text="Show more" Kind="Ghost" Size="Sm" HorizontalOptions="Start" Margin="-16,0,0,0" Clicked="OnShowMoreClicked" />
                </VerticalStackLayout>
            </g:GalleryExample>
            <g:GalleryExample Title="Load more" Description="State the count and fetch the next batch on request with a ghost button at the end of the list." WidthRequest="520" Margin="0,0,0,48">
                <VerticalStackLayout>
                    <cds:CdsContainedList x:Name="EventsList" Label="Recent events" Size="Sm" />
                    <Grid ColumnDefinitions="*,Auto" Padding="16,0,0,0" BackgroundColor="{DynamicResource CdsLayer01}">
                        <cds:CdsText x:Name="EventsCount" TypeStyle="Label01" Tone="Secondary" VerticalOptions="Center" />
                        <cds:CdsButton x:Name="LoadMoreButton" Grid.Column="1" Text="Load more" Kind="Ghost" Size="Sm" Clicked="OnLoadMoreClicked" />
                    </Grid>
                </VerticalStackLayout>
            </g:GalleryExample>
        </FlexLayout>

    </VerticalStackLayout>
</g:GalleryPage>
