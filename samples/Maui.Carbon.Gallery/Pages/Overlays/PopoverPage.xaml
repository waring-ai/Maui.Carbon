<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Overlays.PopoverPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Popover" Description="Click the trigger; click outside or press Escape to close. The surface is layer-01 with a 12x6 caret and drop shadow.">
            <HorizontalStackLayout Spacing="32">
                <cds:CdsPopover x:Name="FilterPopover" Placement="BottomStart">
                    <cds:CdsButton Text="Filter" Kind="Tertiary" Icon="Filter" Size="Md" Clicked="OnFilterClicked" />
                    <cds:CdsPopover.PopoverContent>
                        <VerticalStackLayout Padding="16" Spacing="8" WidthRequest="240">
                            <cds:CdsText Text="Filters" TypeStyle="HeadingCompact01" />
                            <cds:CdsText Text="Region and status filters go here." TypeStyle="Body01" Tone="Secondary" />
                            <cds:CdsButton Text="Apply" Size="Sm" Clicked="OnApplyClicked" />
                        </VerticalStackLayout>
                    </cds:CdsPopover.PopoverContent>
                </cds:CdsPopover>

                <cds:CdsPopover x:Name="ContrastPopover" Placement="Right" IsHighContrast="True">
                    <cds:CdsButton Text="High contrast" Kind="Ghost" Size="Md" Clicked="OnContrastClicked" />
                    <cds:CdsPopover.PopoverContent>
                        <cds:CdsText Text="High-contrast popovers use background-inverse." Tone="Inverse" Padding="16" WidthRequest="220" />
                    </cds:CdsPopover.PopoverContent>
                </cds:CdsPopover>
            </HorizontalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Tab tip" Description="IsTabTip attaches the popover to a toolbar or header: square corners, no caret, no gap to the trigger, aligned to the start (BottomStart) or end (BottomEnd) of the trigger. While open, the trigger takes the layer-01 fill of the content so the two read as one tab. Use a ghost icon button as the trigger.">
            <Border StrokeThickness="0" BackgroundColor="{DynamicResource CdsBackground}" HeightRequest="360" HorizontalOptions="Fill">
                <Grid RowDefinitions="Auto,1,*">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,0">
                        <cds:CdsPopover x:Name="TabTipStartPopover" IsTabTip="True" Placement="BottomStart" IsOpen="True">
                            <cds:CdsIconButton Icon="Settings" Label="Display settings" Kind="Ghost" Size="Lg" Clicked="OnTabTipStartClicked" />
                            <cds:CdsPopover.PopoverContent>
                                <VerticalStackLayout Padding="16" Spacing="8" WidthRequest="256">
                                    <cds:CdsText Text="Display" TypeStyle="HeadingCompact01" />
                                    <cds:CdsText Text="Choose how dense the cluster list is." TypeStyle="Body01" Tone="Secondary" />
                                </VerticalStackLayout>
                            </cds:CdsPopover.PopoverContent>
                        </cds:CdsPopover>
                        <cds:CdsPopover x:Name="TabTipEndPopover" Grid.Column="2" IsTabTip="True" Placement="BottomEnd">
                            <cds:CdsIconButton Icon="Filter" Label="Filter clusters" Kind="Ghost" Size="Lg" Clicked="OnTabTipEndClicked" />
                            <cds:CdsPopover.PopoverContent>
                                <VerticalStackLayout Padding="16" Spacing="8" WidthRequest="256">
                                    <cds:CdsText Text="Filter" TypeStyle="HeadingCompact01" />
                                    <cds:CdsText Text="Region and status filters go here." TypeStyle="Body01" Tone="Secondary" />
                                </VerticalStackLayout>
                            </cds:CdsPopover.PopoverContent>
                        </cds:CdsPopover>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="1" Color="{DynamicResource CdsBorderSubtle01}" />
                </Grid>
            </Border>
        </g:GalleryExample>

        <g:GalleryExample Title="Inside a theme zone" Description="The popover is shown in the page's overlay host but mirrors the trigger's theme and layer.">
            <cds:CdsTheme Theme="G100">
                <ContentView Padding="24">
                    <cds:CdsPopover x:Name="ZonePopover" Placement="BottomStart" IsOpen="True">
                        <cds:CdsButton Text="Open in g100" Kind="Tertiary" Size="Md" Clicked="OnZoneClicked" />
                        <cds:CdsPopover.PopoverContent>
                            <cds:CdsText Text="This surface uses g100's layer-01." Padding="16" WidthRequest="220" />
                        </cds:CdsPopover.PopoverContent>
                    </cds:CdsPopover>
                </ContentView>
            </cds:CdsTheme>
        </g:GalleryExample>

        <cds:CdsText x:Name="Status" Tone="Secondary" Text="No action yet" />

    </VerticalStackLayout>
</g:GalleryPage>
