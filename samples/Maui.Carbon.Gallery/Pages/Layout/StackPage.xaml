<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Layout.StackPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Vertical gaps" Description="Gap is a spacing scale step: 1 is 2, 3 is 8, 5 is 16, 7 is 32, 9 is 48. Smaller gaps read as related, larger gaps as separate.">
            <HorizontalStackLayout Spacing="48">
                <VerticalStackLayout Spacing="8">
                    <cds:CdsText Text="Gap 3 (8)" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsStack Gap="3" WidthRequest="120">
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                    </cds:CdsStack>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <cds:CdsText Text="Gap 5 (16)" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsStack Gap="5" WidthRequest="120">
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                    </cds:CdsStack>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <cds:CdsText Text="Gap 7 (32)" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsStack Gap="7" WidthRequest="120">
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                    </cds:CdsStack>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <cds:CdsText Text="GapValue 56" TypeStyle="Label01" Tone="Secondary" />
                    <cds:CdsStack GapValue="56" WidthRequest="120">
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                        <BoxView HeightRequest="32" Color="{DynamicResource CdsLayerAccent01}" />
                    </cds:CdsStack>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Horizontal" Description="A horizontal stack sizes to its content and never wraps; use a FlexLayout for long lists.">
            <VerticalStackLayout Spacing="24">
                <cds:CdsStack Orientation="Horizontal" Gap="3" HorizontalOptions="Start">
                    <cds:CdsTag Text="us-south" Type="Blue" />
                    <cds:CdsTag Text="prod" Type="Green" />
                    <cds:CdsTag Text="3 nodes" Type="Gray" />
                </cds:CdsStack>
                <cds:CdsStack Orientation="Horizontal" Gap="5" HorizontalOptions="Start">
                    <cds:CdsButton Text="Create cluster" Size="Md" />
                    <cds:CdsButton Text="Cancel" Kind="Secondary" Size="Md" />
                </cds:CdsStack>
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="In context" Description="A form section: gap 6 between fields inside a group, gap 7 between groups, a title above its content.">
            <cds:CdsStack Gap="7" WidthRequest="360" HorizontalOptions="Start">
                <cds:CdsStack Gap="6">
                    <cds:CdsText Text="Create API key" TypeStyle="Heading03" />
                    <cds:CdsTextInput Label="Name" HelperText="Shown in audit logs" Text="deploy-bot" />
                    <cds:CdsTextInput Label="Description (optional)" />
                </cds:CdsStack>
                <cds:CdsStack Orientation="Horizontal" Gap="5">
                    <cds:CdsButton Text="Create key" Size="Md" />
                    <cds:CdsButton Text="Cancel" Kind="Ghost" Size="Md" />
                </cds:CdsStack>
            </cds:CdsStack>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
