<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Containers.TilePage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Tile" Description="A flat layer-01 container with 16px padding, at least 64 high and 128 wide. No shadow, no border: separation comes from the layer step.">
            <HorizontalStackLayout Spacing="16">
                <cds:CdsTile WidthRequest="240">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="4.2 TB of 10 TB in 48 buckets." Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsTile>
                <cds:CdsTile WidthRequest="240">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="Active clusters" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="12" TypeStyle="Heading05" />
                    </VerticalStackLayout>
                </cds:CdsTile>
            </HorizontalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Clickable tile" Description="The whole tile is one link or button: layer-hover-01 on hover, layer-active-01 while pressed, and a 20px trailing icon in icon-interactive (arrow by default, launch for an external destination). The tile reserves 48px for the icon.">
            <HorizontalStackLayout Spacing="16">
                <cds:CdsClickableTile Href="https://carbondesignsystem.com" WidthRequest="240">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="12 clusters in 4 regions." Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
                <cds:CdsClickableTile Href="https://carbondesignsystem.com" Icon="Launch" WidthRequest="240">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="API reference" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="Opens in your browser." Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
                <cds:CdsClickableTile Icon="{x:Null}" WidthRequest="240">
                    <cds:CdsText Text="No icon" />
                </cds:CdsClickableTile>
                <cds:CdsClickableTile IsEnabled="False" WidthRequest="240">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="Billing" TypeStyle="HeadingCompact01" Tone="Disabled" />
                        <cds:CdsText Text="Not available on your plan." Tone="Disabled" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
            </HorizontalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Interactive" Description="Activate the clickable tile with a click or tap, or focus it with Tab and press Enter.">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Start">
                <cds:CdsClickableTile Clicked="OnTileClicked" WidthRequest="280">
                    <VerticalStackLayout Spacing="8">
                        <cds:CdsText Text="Create cluster" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="Start with a template." Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
                <cds:CdsText x:Name="Status" Tone="Secondary" Text="Not clicked" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="AI label" Description="A tile whose decorator is an AI label takes Carbon's AI presence: an aura rising from the bottom edge into the layer-01 fill, a 1px gradient border, and a soft drop shadow. The label sits 16 from the top and end. Clickable tiles swap to the hover fill on hover. HasRoundedCorners gives the tile a 4px radius, and a label in its revert state keeps the AI styling, as in Carbon. Keep the first line short: nothing reserves room for the label.">
            <g:WrapLayout>
                <cds:CdsTile WidthRequest="240" Margin="0,0,16,16">
                    <cds:CdsTile.Decorator>
                        <cds:CdsAILabel Label="Why this is suggested">
                            <cds:CdsAILabelContent>
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                    <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsAILabelContent>
                        </cds:CdsAILabel>
                    </cds:CdsTile.Decorator>
                    <VerticalStackLayout Spacing="4">
                        <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="4.2 TB of 10 TB" Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsTile>
                <cds:CdsTile WidthRequest="240" HasRoundedCorners="True" Margin="0,0,16,16">
                    <cds:CdsTile.Decorator>
                        <cds:CdsAILabel Label="Why this is suggested">
                            <cds:CdsAILabelContent>
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                    <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsAILabelContent>
                        </cds:CdsAILabel>
                    </cds:CdsTile.Decorator>
                    <VerticalStackLayout Spacing="4">
                        <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="4.2 TB of 10 TB" Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsTile>
                <cds:CdsClickableTile WidthRequest="240" Margin="0,0,16,16">
                    <cds:CdsClickableTile.Decorator>
                        <cds:CdsAILabel Label="Why this is suggested">
                            <cds:CdsAILabelContent>
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                    <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsAILabelContent>
                        </cds:CdsAILabel>
                    </cds:CdsClickableTile.Decorator>
                    <VerticalStackLayout Spacing="4">
                        <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="12 clusters in 4 regions" Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
                <cds:CdsClickableTile WidthRequest="240" HasRoundedCorners="True" Margin="0,0,16,16">
                    <cds:CdsClickableTile.Decorator>
                        <cds:CdsAILabel Label="Why this is suggested">
                            <cds:CdsAILabelContent>
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                    <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsAILabelContent>
                        </cds:CdsAILabel>
                    </cds:CdsClickableTile.Decorator>
                    <VerticalStackLayout Spacing="4">
                        <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="12 clusters in 4 regions" Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsClickableTile>
                <cds:CdsTile WidthRequest="240" Margin="0,0,16,16">
                    <cds:CdsTile.Decorator>
                        <cds:CdsAILabel Label="Why this is suggested" IsRevertActive="True">
                            <cds:CdsAILabelContent>
                                <VerticalStackLayout Spacing="8">
                                    <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                    <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                </VerticalStackLayout>
                            </cds:CdsAILabelContent>
                        </cds:CdsAILabel>
                    </cds:CdsTile.Decorator>
                    <VerticalStackLayout Spacing="4">
                        <cds:CdsText Text="Edited quota" TypeStyle="HeadingCompact01" />
                        <cds:CdsText Text="Reverted values show" Tone="Secondary" />
                    </VerticalStackLayout>
                </cds:CdsTile>
            </g:WrapLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="AI label in every theme" Description="The aura, border, hover fill and shadow follow the theme.">
            <g:ThemeStrip>
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="8">
                            <cds:CdsTile >
                                <cds:CdsTile.Decorator>
                                    <cds:CdsAILabel Label="Why this is suggested">
                                        <cds:CdsAILabelContent>
                                            <VerticalStackLayout Spacing="8">
                                                <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                                <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                            </VerticalStackLayout>
                                        </cds:CdsAILabelContent>
                                    </cds:CdsAILabel>
                                </cds:CdsTile.Decorator>
                                <VerticalStackLayout Spacing="4">
                                    <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                                    <cds:CdsText Text="4.2 TB of 10 TB" Tone="Secondary" />
                                </VerticalStackLayout>
                            </cds:CdsTile>
                            <cds:CdsClickableTile HasRoundedCorners="True">
                                <cds:CdsClickableTile.Decorator>
                                    <cds:CdsAILabel Label="Why this is suggested">
                                        <cds:CdsAILabelContent>
                                            <VerticalStackLayout Spacing="8">
                                                <cds:CdsText Text="AI explained" TypeStyle="Label01" Tone="Secondary" />
                                                <cds:CdsText Text="Suggested because your last three exports ran past the 10 TB quota." TypeStyle="Body01" />
                                            </VerticalStackLayout>
                                        </cds:CdsAILabelContent>
                                    </cds:CdsAILabel>
                                </cds:CdsClickableTile.Decorator>
                                <VerticalStackLayout Spacing="4">
                                    <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                                    <cds:CdsText Text="12 clusters" Tone="Secondary" />
                                </VerticalStackLayout>
                            </cds:CdsClickableTile>
                        </VerticalStackLayout>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

        <g:GalleryExample Title="On a layer" Description="A tile on a layer-01 surface sits inside a CdsLayer so it steps up to layer-02.">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="8">
                            <cds:CdsTile>
                                <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                            </cds:CdsTile>
                            <cds:CdsClickableTile>
                                <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                            </cds:CdsClickableTile>
                        </VerticalStackLayout>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

        <g:GalleryExample Title="Themes" Description="The same tiles in White, Gray 10, Gray 90 and Gray 100.">
            <g:ThemeStrip>
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="8">
                            <cds:CdsTile>
                                <cds:CdsText Text="Storage used" TypeStyle="HeadingCompact01" />
                            </cds:CdsTile>
                            <cds:CdsClickableTile>
                                <cds:CdsText Text="View clusters" TypeStyle="HeadingCompact01" />
                            </cds:CdsClickableTile>
                        </VerticalStackLayout>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
