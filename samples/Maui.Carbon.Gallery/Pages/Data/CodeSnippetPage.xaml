<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Data.CodeSnippetPage">
    <VerticalStackLayout Spacing="48">

        <g:GalleryExample Title="Inline" Description="Copies on click; hide the copy button to render plain code. Inline snippets sit in the text flow and never wrap over lines.">
            <FlexLayout Wrap="Wrap" AlignItems="Center" MaximumWidthRequest="720" HorizontalOptions="Start">
                <cds:CdsText Text="Set " TypeStyle="Body01" />
                <cds:CdsCodeSnippet Type="Inline" Code="KUBECONFIG" Feedback="Copied to clipboard" />
                <cds:CdsText Text=" to the downloaded file, then check access with " TypeStyle="Body01" />
                <cds:CdsCodeSnippet Type="Inline" Code="kubectl get nodes" Feedback="Copied to clipboard" />
                <cds:CdsText Text=". The namespace " TypeStyle="Body01" />
                <cds:CdsCodeSnippet Type="Inline" Code="kube-system" HideCopyButton="True" />
                <cds:CdsText Text=" is managed for you." TypeStyle="Body01" />
            </FlexLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Single line" Description="One line with a 40px copy button; long commands scroll sideways under a fade.">
            <VerticalStackLayout Spacing="16">
                <cds:CdsCodeSnippet Code="cloud login --sso --region us-east" Label="Log in command" Feedback="Copied to clipboard" />
                <cds:CdsCodeSnippet x:Name="LongSingle" Label="Add worker nodes with the API" Feedback="Copied to clipboard" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Multi-line" Description="Twenty-six lines collapse to fifteen with Show more; Show less collapses them again.">
            <cds:CdsCodeSnippet x:Name="Manifest" Type="Multi" Label="Deployment manifest" Feedback="Copied to clipboard" />
        </g:GalleryExample>

        <g:GalleryExample Title="Expanded, short, wrapped, no copy" Description="An expanded snippet, a short one that wraps long lines (no Show more), and one without a copy button.">
            <VerticalStackLayout Spacing="16">
                <cds:CdsCodeSnippet x:Name="ExpandedManifest" Type="Multi" IsExpanded="True" Label="Deployment manifest, expanded" />
                <cds:CdsCodeSnippet x:Name="Wrapped" Type="Multi" IsWrapText="True" Label="Environment variables" />
                <cds:CdsCodeSnippet x:Name="Output" Type="Multi" HideCopyButton="True" Label="Command output" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Disabled" Description="Disabled snippets use text-disabled and icon-disabled and block copying.">
            <VerticalStackLayout Spacing="16">
                <cds:CdsCodeSnippet Code="cloud cluster delete dev-jp-tok" IsEnabled="False" />
                <cds:CdsCodeSnippet x:Name="DisabledMulti" Type="Multi" IsEnabled="False" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Interactive" Description="Clicking copy writes to the clipboard and shows the feedback for two seconds.">
            <VerticalStackLayout Spacing="16">
                <cds:CdsCodeSnippet Code="cloud ks cluster config --cluster prod-us-east-1" Clicked="OnCopied" Label="Download cluster configuration" />
                <cds:CdsText x:Name="Status" Tone="Secondary" Text="Nothing copied yet" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Themes" Description="The fill follows the layer tokens: the second row of each theme sits on a layer.">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="16">
                            <cds:CdsCodeSnippet Code="cloud login --sso" />
                            <cds:CdsCodeSnippet Type="Inline" Code="kubectl get nodes" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>

    </VerticalStackLayout>
</g:GalleryPage>
