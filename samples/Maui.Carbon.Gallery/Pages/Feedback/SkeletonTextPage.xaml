<?xml version="1.0" encoding="utf-8" ?>
<g:GalleryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:cds="https://github.com/waring-ai/Maui.Carbon"
               xmlns:g="clr-namespace:Maui.Carbon.Gallery.Infrastructure"
               x:Class="Maui.Carbon.Gallery.Pages.Feedback.SkeletonTextPage">
    <VerticalStackLayout Spacing="48">
        <g:GalleryExample Title="Line, heading and paragraph" Description="16 high bars (24 for headings), 8 between lines. Paragraph widths cycle 100/85/95/75/90 percent.">
            <VerticalStackLayout Spacing="24" WidthRequest="480" HorizontalOptions="Start">
                <cds:CdsSkeletonText />
                <cds:CdsSkeletonText WidthPercent="55" />
                <cds:CdsSkeletonText IsHeading="True" WidthPercent="55" />
                <cds:CdsSkeletonText IsParagraph="True" LineCount="4" />
                <cds:CdsSkeletonText IsParagraph="True" LineCount="3" WidthPercent="70" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="In context" Description="A loading card: heading, text and a placeholder together, replaced progressively by real content. Mark the region busy yourself.">
            <VerticalStackLayout Spacing="16" WidthRequest="320" HorizontalOptions="Start">
                <cds:CdsSkeletonText IsHeading="True" WidthPercent="55" />
                <cds:CdsSkeletonText IsParagraph="True" LineCount="2" />
                <cds:CdsSkeletonPlaceholder WidthRequest="288" HeightRequest="96" />
            </VerticalStackLayout>
        </g:GalleryExample>

        <g:GalleryExample Title="Themes">
            <g:ThemeStrip Layered="True">
                <g:ThemeStrip.Template>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="12">
                            <cds:CdsSkeletonText IsHeading="True" WidthPercent="60" />
                            <cds:CdsSkeletonText IsParagraph="True" LineCount="3" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </g:ThemeStrip.Template>
            </g:ThemeStrip>
        </g:GalleryExample>
    </VerticalStackLayout>
</g:GalleryPage>
